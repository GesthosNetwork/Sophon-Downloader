<Window x:Class="SophonDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SophonDownloader"
        Icon="../Assets/app.ico"
        Title="SophonDownloader"
        Width="1280"
        Height="760"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202124"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#475569"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelStrongBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DropdownBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DropdownHoverBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="DropdownSelectedBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DFE3E8"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#DFE3E8"/>
        <SolidColorBrush x:Key="ControlFocusBrush" Color="#475569"/>
        <SolidColorBrush x:Key="OnlineBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="OfflineBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9EDF1"/>
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelStrongBackgroundBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="InputBackgroundGradientBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ModeButtonBackgroundBrush" Color="#475569"/>
        <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#475569"/>
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#334155"/>
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#475569"/>
        <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#334155"/>
        <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#334155"/>
        <SolidColorBrush x:Key="CancelButtonBackgroundBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="CancelButtonHoverBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerSoftBackgroundBrush" Color="#FFF1F2"/>
        <SolidColorBrush x:Key="DangerSoftHoverBrush" Color="#FFE4E6"/>
        <SolidColorBrush x:Key="ReloadButtonBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LogoBackgroundBrush" Color="#475569"/>
        <SolidColorBrush x:Key="GameTextPanelBrush" Color="#D9FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundScrimBrush" Color="#00000000"/>
        <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeaderHoverBrush" Color="#334155"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HeaderHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ModeBorder"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ModeBorder" Property="Opacity" Value=".78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModeBorder" Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideNavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavigationBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,0,0"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavigationBorder" Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DownloadButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DownloadButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DownloadButtonBorder" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DownloadButtonBorder" Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DownloadButtonBorder" Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SecondaryButtonPressedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransparentComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Background="{DynamicResource InputBackgroundGradientBrush}"/>

                            <ContentPresenter Margin="14,0,42,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <Path Width="9"
                                  Height="5"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  Fill="{DynamicResource SecondaryTextBrush}"
                                  Data="M 0 0 L 9 0 L 4.5 5 Z"/>

                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" CornerRadius="9"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,6,0,0"
                                        Background="{DynamicResource DropdownBackgroundBrush}"
                                        TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="5">
                                    <ScrollViewer MaxHeight="300"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ControlFocusBrush}"/>
                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransparentComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DropdownHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DropdownSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VoiceCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SophonContentCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="ReloadButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Reload manifest"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ReloadBorder"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Background="{DynamicResource ReloadButtonBackgroundBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ReloadBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter TargetName="ReloadBorder" Property="Opacity" Value=".95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ReloadBorder" Property="Opacity" Value=".8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ReloadBorder" Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource BorderBrush}"
            CornerRadius="14"
            SnapsToDevicePixels="True">

        <Grid x:Name="RootLayoutGrid">
            <Border x:Name="RootContentBorder"
                Margin="1"
                Background="Transparent"
                CornerRadius="13"
                SnapsToDevicePixels="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="DistributionNoticeRow" Height="0"/>
                </Grid.RowDefinitions>

                <Border x:Name="FullWindowBackgroundBorder"
                        Grid.RowSpan="2"
                        Panel.ZIndex="0"
                        Background="Transparent"
                        IsHitTestVisible="False"/>

                <Border x:Name="FullWindowScrimBorder"
                        Grid.RowSpan="2"
                        Panel.ZIndex="0"
                        Background="{DynamicResource BackgroundScrimBrush}"
                        IsHitTestVisible="False"/>

                <Border Grid.Row="0"
                        Background="Transparent"
                        CornerRadius="13,13,0,0"
                        Panel.ZIndex="1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="18,0">

                            <Image Source="../Assets/app.ico"
                                   Width="24"
                                   Height="24"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"/>

                            <TextBlock x:Name="AppTitleText"
                                       Text="SOPHON DOWNLOADER"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>

                            <TextBlock x:Name="AppVersionText"
                                       Text="• v0.0.0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SophonModeButton"
                                        Content="SOPHON MODE"
                                        Style="{StaticResource ModeButtonStyle}"
                                        Click="SophonModeButton_Click"/>

                                <Button x:Name="LegacyModeButton"
                                        Content="LEGACY MODE"
                                        Style="{StaticResource ModeButtonStyle}"
                                        Margin="4,0,0,0"
                                        Click="LegacyModeButton_Click"/>
                            </StackPanel>

                            <Button x:Name="ReloadButton"
                                    Content="⟳"
                                    Style="{StaticResource ReloadButtonStyle}"
                                    Margin="8,0,0,0"
                                    Click="ReloadButton_Click"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Content="—"
                                    Style="{StaticResource WindowButtonStyle}"
                                    Click="MinimizeButton_Click"/>
                            <Button Content="×"
                                    Style="{StaticResource WindowButtonStyle}"
                                    FontSize="18"
                                    Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="188"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SidebarBorder" Grid.Column="0"
                            Panel.ZIndex="1"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,0"
                            Padding="12,18">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="MAIN"
                                           Foreground="{DynamicResource LabelBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="6,0,6,10"/>

                                <Button x:Name="DashboardNavButton"
                                        Content="Dashboard"
                                        Tag="⌂"
                                        Style="{StaticResource SideNavigationButtonStyle}"
                                        Click="DashboardNavButton_Click"/>

                                <Button x:Name="DownloadsNavButton"
                                        Content="Downloads"
                                        Tag="≡"
                                        Style="{StaticResource SideNavigationButtonStyle}"
                                        Click="DownloadsNavButton_Click"/>

                                <TextBlock Text="PREFERENCE"
                                           Foreground="{DynamicResource LabelBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="6,24,6,10"/>

                                <Button x:Name="SettingsNavButton"
                                        Content="Settings"
                                        Tag="⚙"
                                        Style="{StaticResource SideNavigationButtonStyle}"
                                        Click="SettingsNavButton_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Margin="0,28,0,0">
                                <TextBlock Text="SUPPORT"
                                           Foreground="{DynamicResource LabelBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="6,0,6,10"/>

                                <Button x:Name="UpdatesNavButton" Content="Check for Updates" Tag="↻"
                                        Style="{StaticResource SideNavigationButtonStyle}"
                                        Click="CheckForUpdatesButton_Click"/>

                                <Button x:Name="AboutNavButton" Content="About" Tag="ⓘ"
                                        Style="{StaticResource SideNavigationButtonStyle}"
                                        Click="AboutButton_Click"/>

                                <Button x:Name="LicenseNavButton" Content="License" Tag="©"
                                        Style="{StaticResource SideNavigationButtonStyle}"
                                        Click="LicenseButton_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Margin="6,0,6,2">

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse x:Name="SidebarConnectionIndicator"
                                             Width="8"
                                             Height="8"
                                             Fill="{DynamicResource OfflineBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>

                                    <TextBlock x:Name="SidebarConnectionText"
                                               Text="Offline"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,10,0,0">
                                    <Image Source="../Assets/app.ico"
                                           Width="18"
                                           Height="18"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center"/>

                                    <StackPanel VerticalAlignment="Center"
                                                Margin="7,0,0,0">
                                        <TextBlock Text="SOPHON DOWNLOADER"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="9"
                                                   FontWeight="Medium"/>
                                        <TextBlock x:Name="SidePanelVersionText"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="8"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Panel.ZIndex="1">
                        <Rectangle Fill="Transparent"/>

                        <local:DownloadsView x:Name="DownloadsView"
                                             Visibility="Collapsed"
                                             Margin="32,28,32,28"/>

                        <local:SettingsView x:Name="SettingsView"
                                            Visibility="Collapsed"
                                            Margin="32,28,32,28"/>

                        <local:UpdateView x:Name="UpdateView"
                                          Visibility="Collapsed"
                                          Margin="32,28,32,28"/>

                        <local:AboutView x:Name="AboutView"
                                         Visibility="Collapsed"
                                         Margin="32,28,32,28"/>

                        <local:LicenseView x:Name="LicenseView"
                                           Visibility="Collapsed"
                                           Margin="32,28,32,28"/>

                        <Grid x:Name="LegacyView"
                              Margin="46,38,46,32">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Border VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource GameTextPanelBrush}"
                                        CornerRadius="16"
                                        Padding="22,18,22,20">
                                    <StackPanel Width="600">

                                    <TextBlock x:Name="LegacyGameTitleText"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="40"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="GAME"
                                               Foreground="{DynamicResource LabelBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,20,0,8"/>

                                    <ComboBox x:Name="GameComboBox"
                                              Width="380"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource TransparentComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource TransparentComboBoxItemStyle}"
                                              SelectionChanged="GameComboBox_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="13"
                                                           FontWeight="Medium"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="VERSION"
                                               Foreground="{DynamicResource LabelBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,14,0,8"/>

                                    <ComboBox x:Name="VersionComboBox"
                                              Width="380"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource TransparentComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource TransparentComboBoxItemStyle}"
                                              SelectionChanged="VersionComboBox_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="13"
                                                           FontWeight="Medium"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    </StackPanel>
                                </Border>

                                <StackPanel HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Width="285">

                                    <Border BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="16"
                                            Padding="18"
                                            Background="{DynamicResource GameTextPanelBrush}">

                                        <StackPanel>
                                            <TextBlock Text="DOWNLOAD TYPE"
                                                       Foreground="{DynamicResource LabelBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8"/>

                                            <ComboBox x:Name="LegacyDownloadModeComboBox"
                                                      Style="{StaticResource TransparentComboBoxStyle}"
                                                      ItemContainerStyle="{StaticResource TransparentComboBoxItemStyle}"
                                                      SelectionChanged="LegacyDownloadModeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Full Download"
                                                              IsSelected="True"/>
                                                <ComboBoxItem Content="Patch Download"/>
                                            </ComboBox>

                                            <StackPanel x:Name="LegacyPatchSourcePanel"
                                                        Visibility="Collapsed">

                                                <TextBlock Text="FROM VERSION"
                                                           Foreground="{DynamicResource LabelBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="0,14,0,8"/>

                                                <ComboBox x:Name="LegacyFromVersionComboBox"
                                                          Style="{StaticResource TransparentComboBoxStyle}"
                                                          ItemContainerStyle="{StaticResource TransparentComboBoxItemStyle}"/>
                                            </StackPanel>

                                            <TextBlock Text="CONTENT"
                                                       Foreground="{DynamicResource LabelBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,16,0,8"/>

                                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="8"
                                                    Height="168">

                                                <ScrollViewer MaxHeight="300"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">

                                                    <ItemsControl x:Name="LegacyContentItemsControl">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Checked="LegacyContentCheckBox_Changed"
                                                                          Unchecked="LegacyContentCheckBox_Changed"
                                                                          Style="{StaticResource VoiceCheckBoxStyle}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                </ScrollViewer>
                                            </Border>

                                            <TextBlock x:Name="LegacyContentSummaryText"
                                                       Text="No content selected"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Margin="2,7,0,0"/>

                                            <TextBlock x:Name="SophonDestinationLabel" Text="SAVE TO"
                                                       Foreground="{DynamicResource LabelBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,18,0,8"/>

                                            <Border Height="40"
                                                    Background="{DynamicResource InputBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox x:Name="LegacyDestinationTextBox"
                                                             Height="38"
                                                             VerticalContentAlignment="Center"
                                                             Padding="10,0"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                                             BorderThickness="0"
                                                             FontSize="12"
                                                             FontWeight="Medium"/>

                                                    <Button Grid.Column="1"
                                                            Content="..."
                                                            Height="38"
                                                            Width="42"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                                            BorderThickness="0"
                                                            FontSize="15"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Click="LegacyBrowseButton_Click">

                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="BrowseBorder"
                                                                        Background="Transparent"
                                                                        CornerRadius="0,8,8,0">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="BrowseBorder"
                                                                                Property="Background"
                                                                                Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="BrowseBorder"
                                                                                Property="Opacity"
                                                                                Value=".8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Margin="0,20,0,0">

                                    <Button x:Name="LegacyDownloadButton"
                                            Content="DOWNLOAD"
                                            Width="150"
                                            BorderThickness="0"
                                            BorderBrush="Transparent"
                                            Style="{StaticResource DownloadButtonStyle}"
                                            Click="LegacyDownloadButton_Click"
                                            Margin="0,0,8,0"/>

                                    <Button x:Name="LegacyExplorerButton"
                                            Content="EXPLORE"
                                            Width="140"
                                            Visibility="Collapsed"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="LegacyExplorerButton_Click"/>
                                </StackPanel>
                        </Grid>

                        <Grid x:Name="SophonView"
                              Visibility="Collapsed"
                              Margin="46,38,46,32">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Border VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource GameTextPanelBrush}"
                                        CornerRadius="16"
                                        Padding="22,18,22,20">
                                    <StackPanel Width="600">

                                    <TextBlock x:Name="SophonGameTitleText"
                                               Text="Sophon"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="40"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="GAME"
                                               Foreground="{DynamicResource LabelBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,20,0,8"/>

                                    <ComboBox x:Name="SophonGameComboBox"
                                              Width="380"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource TransparentComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource TransparentComboBoxItemStyle}"
                                              SelectionChanged="SophonGameComboBox_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="13"
                                                           FontWeight="Medium"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="DOWNLOAD MODE"
                                               Foreground="{DynamicResource LabelBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,14,0,8"/>

                                    <ComboBox x:Name="SophonDownloadModeComboBox"
                                              Width="380"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource TransparentComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource TransparentComboBoxItemStyle}"
                                              SelectionChanged="SophonDownloadModeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Full Download" IsSelected="True"/>
                                        <ComboBoxItem Content="Patch Download"/>
                                    </ComboBox>

                                    <TextBlock Text="VERSION"
                                               Foreground="{DynamicResource LabelBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,14,0,8"/>

                                    <ComboBox x:Name="SophonVersionComboBox"
                                              Width="380"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource TransparentComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource TransparentComboBoxItemStyle}"
                                              SelectionChanged="SophonVersionComboBox_SelectionChanged"/>

                                    <StackPanel x:Name="SophonPatchSourcePanel"
                                                Visibility="Collapsed">
                                        <TextBlock Text="FROM VERSION"
                                                   Foreground="{DynamicResource LabelBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,14,0,8"/>

                                        <ComboBox x:Name="SophonFromVersionComboBox"
                                                  Width="380"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource TransparentComboBoxStyle}"
                                                  ItemContainerStyle="{StaticResource TransparentComboBoxItemStyle}"
                                                  SelectionChanged="SophonFromVersionComboBox_SelectionChanged"/>
                                    </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Width="285">

                                    <Border BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="16"
                                            Padding="18"
                                            Background="{DynamicResource GameTextPanelBrush}">

                                        <StackPanel>
                                            <TextBlock Text="CHANNEL"
                                                       Foreground="{DynamicResource LabelBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8"/>

                                            <ComboBox x:Name="SophonChannelComboBox"
                                                      Style="{StaticResource TransparentComboBoxStyle}"
                                                      ItemContainerStyle="{StaticResource TransparentComboBoxItemStyle}"
                                                      SelectionChanged="SophonChannelComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Main"
                                                              Tag="main"
                                                              IsSelected="True"/>
                                                <ComboBoxItem Content="Predownload"
                                                              Tag="predownload"/>
                                            </ComboBox>

                                            <TextBlock Text="CONTENT"
                                                       Foreground="{DynamicResource LabelBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,16,0,8"/>

                                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="8"
                                                    Height="168">

                                                <ScrollViewer MaxHeight="300"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              CanContentScroll="True">

                                                    <ItemsControl x:Name="SophonContentItemsControl">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Checked="SophonContentCheckBox_Changed"
                                                                          Unchecked="SophonContentCheckBox_Changed"
                                                                          Style="{StaticResource SophonContentCheckBoxStyle}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                </ScrollViewer>
                                            </Border>

                                            <TextBlock x:Name="SophonContentSummaryText"
                                                       Text="No content selected"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Margin="2,7,0,0"/>

                                            <TextBlock Text="SAVE TO"
                                                       Foreground="{DynamicResource LabelBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,18,0,8"/>

                                            <Border Height="40"
                                                    Background="{DynamicResource InputBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox x:Name="SophonDestinationTextBox"
                                                             Height="38"
                                                             VerticalContentAlignment="Center"
                                                             Padding="10,0"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                                             BorderThickness="0"
                                                             FontSize="12"
                                                             FontWeight="Medium"/>

                                                    <Button Grid.Column="1"
                                                            Content="..."
                                                            Height="38"
                                                            Width="42"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                                            BorderThickness="0"
                                                            FontSize="15"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Click="SophonBrowseButton_Click">

                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="BrowseBorder"
                                                                        Background="Transparent"
                                                                        CornerRadius="0,8,8,0">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="BrowseBorder"
                                                                                Property="Background"
                                                                                Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="BrowseBorder"
                                                                                Property="Opacity"
                                                                                Value=".8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Margin="0,20,0,0">

                                    <Button x:Name="SophonDownloadButton"
                                            Content="DOWNLOAD"
                                            Width="150"
                                            BorderThickness="0"
                                            BorderBrush="Transparent"
                                            Style="{StaticResource DownloadButtonStyle}"
                                            Click="SophonDownloadButton_Click"
                                            Margin="0,0,8,0"/>

                                    <Button x:Name="SophonExplorerButton"
                                            Content="EXPLORE"
                                            Width="140"
                                            Visibility="Collapsed"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="SophonExplorerButton_Click"/>
                                </StackPanel>
                        </Grid>



                        <TextBlock x:Name="CopyrightTextBlock"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,46,5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Opacity=".85"/>

                    </Grid>


                </Grid>

                <Border x:Name="DistributionNoticeMarqueeBorder"
                        Grid.Row="2"
                        Margin="1,0,1,1"
                        Background="#FFF1F2"
                        BorderBrush="#FECACA"
                        BorderThickness="0,1,0,0"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                    <Canvas x:Name="DistributionNoticeMarqueeCanvas"
                            ClipToBounds="True">
                        <TextBlock x:Name="DistributionNoticeMarqueeText"
                                   Text=""
                                   Foreground="#DC2626"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="DistributionNoticeMarqueeTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Border>

            </Grid>
        </Border>

        <Border x:Name="ExploreHost"
                Panel.ZIndex="1100"
                Margin="1"
                Background="{DynamicResource WindowBackgroundBrush}"
                CornerRadius="13"
                ClipToBounds="True"
                Visibility="Collapsed"/>

        <Border x:Name="StartupOverlay"
                Panel.ZIndex="1000"
                Background="{DynamicResource WindowBackgroundBrush}"
                Opacity="0.96"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                CornerRadius="14"
                ClipToBounds="True">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel x:Name="StartupLoadingPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="820"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <ScaleTransform x:Name="StartupLoadingScaleTransform" ScaleX="1" ScaleY="1"/>
                    </StackPanel.RenderTransform>
                    <TextBlock x:Name="StartupLoadingTitle"
                               Text="Initializing SophonDownloader..."
                               HorizontalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="StartupLoadingStatus"
                               Text="Preparing application startup..."
                               HorizontalAlignment="Center"
                               Margin="0,14,0,10"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Border Width="750" Height="8" HorizontalAlignment="Center"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="8" ClipToBounds="True">
                        <ProgressBar Height="8" Minimum="0" Maximum="100" IsIndeterminate="True"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
