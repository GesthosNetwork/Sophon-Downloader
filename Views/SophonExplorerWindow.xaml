<Window x:Class="SophonDownloader.SophonExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SophonDownloader.Models"
        Title="Sophon Explorer"
        Icon="../Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202124"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#475569"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#334155"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelStrongBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DFE3E8"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#DFE3E8"/>
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelStrongBackgroundBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#475569"/>
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#334155"/>
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#475569"/>
        <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CancelButtonBackgroundBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="CancelButtonHoverBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="LogoBackgroundBrush" Color="#475569"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerCancelButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ExplorerSecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource CancelButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Width" Value="86"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{DynamicResource CancelButtonBackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CancelButtonHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <Border Width="26" Height="26"
                                CornerRadius="8"
                                VerticalAlignment="Center"
                                Background="{DynamicResource LogoBackgroundBrush}">
                            <Image Source="../Assets/app.ico"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="SOPHON EXPLORER"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                        <TextBlock Text="• Explorer"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click"/>
                        <Button Content="×" Style="{StaticResource WindowButtonStyle}" FontSize="18" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SOPHON EXPLORER"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="TitleText"
                                   Text="Content"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="SummaryText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"/>
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource PanelStrongBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SelectAllButton"
                                Grid.Column="0"
                                Content="SELECT ALL"
                                Style="{StaticResource ExplorerSecondaryButtonStyle}"
                                Click="SelectAllButton_Click"
                                Margin="0,0,6,0"/>

                        <Button x:Name="ClearSelectionButton"
                                Grid.Column="1"
                                Content="CLEAR"
                                Style="{StaticResource ExplorerSecondaryButtonStyle}"
                                Click="ClearSelectionButton_Click"
                                Margin="0,0,6,0"/>

                        <Button x:Name="DownloadSelectedButton"
                                Grid.Column="2"
                                Content="DOWNLOAD SELECTED"
                                Style="{StaticResource ExplorerPrimaryButtonStyle}"
                                Click="DownloadSelectedButton_Click"
                                Margin="0,0,14,0"/>

                        <TextBlock x:Name="SelectionSummaryText"
                                   Grid.Column="3"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   FontSize="11"
                                   Text="0 files selected"/>

                        <CheckBox x:Name="ExplorerDeleteChunksCheckBox"
                                  Grid.Column="4"
                                  Content="Delete chunks after extraction"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                  FontSize="11"
                                  Margin="14,0,6,0"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition x:Name="DetailsColumn" Width="390" MinWidth="280" MaxWidth="700"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8">
                        <TreeView x:Name="ExplorerTree" SelectedItemChanged="ExplorerTree_SelectedItemChanged">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:SophonExplorerNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Click="NodeCheckBox_Click"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  Tag="{Binding}"/>
                                        <Image Source="{Binding Icon}"
                                               Width="16"
                                               Height="16"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{DynamicResource ButtonBackgroundBrush}"
                                  ShowsPreview="True"/>

                    <Border Grid.Column="2"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="FILE INFORMATION"
                                       Foreground="{DynamicResource LabelBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="SelectedNameText"
                                       Grid.Row="1"
                                       Text="-"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>

                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                <TextBlock Text="PATH"
                                           Foreground="{DynamicResource LabelBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectedPathText"
                                           Text="-"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="3" Margin="0,16,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SIZE"
                                               Foreground="{DynamicResource LabelBrush}"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SelectedSizeText"
                                               Text="-"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CHUNKS"
                                               Foreground="{DynamicResource LabelBrush}"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SelectedChunkCountText"
                                               Text="-"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MD5"
                                               Foreground="{DynamicResource LabelBrush}"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SelectedMd5Text"
                                               Text="-"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="CHUNKS"
                                           Foreground="{DynamicResource LabelBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <ListView x:Name="ChunkListView" Grid.Row="1">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="#" Width="30" DisplayMemberBinding="{Binding Index}"/>
                                            <GridViewColumn Header="ID" Width="110" DisplayMemberBinding="{Binding Id}"/>
                                            <GridViewColumn Header="COMPRESSED" Width="92" DisplayMemberBinding="{Binding CompressedSizeText}"/>
                                            <GridViewColumn Header="UNCOMPRESSED" Width="105" DisplayMemberBinding="{Binding UncompressedSizeText}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="LoadingOverlay"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Panel.ZIndex="20"
                            Background="{DynamicResource ModalBackgroundBrush}"
                            Visibility="Collapsed">
                        <Grid>
                            <Border Width="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="24">
                                <StackPanel>
                                    <TextBlock x:Name="LoadingTitleText"
                                               Text="LOADING CONTENT"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LoadingStatusText"
                                               Text="Reading remote content manifest..."
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                    <ProgressBar x:Name="LoadingProgressBar"
                                                 IsIndeterminate="True"
                                                 Margin="0,18,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Background="{DynamicResource PanelStrongBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="94"/>
                            <ColumnDefinition Width="94"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="DownloadStatusText"
                                       Text="Ready."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="DownloadProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Margin="0,7,0,0"
                                         Visibility="Collapsed"
                                         HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <TextBlock x:Name="DownloadSpeedText"
                                   Grid.Column="1"
                                   Text="--"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="10,0,12,0"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="DownloadProgressText"
                                   Grid.Column="2"
                                   Text=""
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,12,0"
                                   Visibility="Collapsed"/>

                        <Button x:Name="PauseButton"
                                Grid.Column="3"
                                Content="PAUSE"
                                Style="{StaticResource ExplorerSecondaryButtonStyle}"
                                Width="86"
                                HorizontalAlignment="Center"
                                Click="PauseButton_Click"
                                Visibility="Collapsed"/>

                        <Button x:Name="CancelButton"
                                Grid.Column="4"
                                Content="CANCEL"
                                Style="{StaticResource ExplorerCancelButtonStyle}"
                                Width="86"
                                HorizontalAlignment="Center"
                                Click="CancelButton_Click"
                                Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
