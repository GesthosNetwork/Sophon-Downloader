<Window x:Class="SophonDownloader.LegacyExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SophonDownloader.Models"
        Icon="../Assets/app.ico"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Title="Legacy Explore">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202124"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#475569"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#334155"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelStrongBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DFE3E8"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#DFE3E8"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelStrongBackgroundBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#475569"/>
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#334155"/>
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#475569"/>
        <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CancelButtonBackgroundBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="CancelButtonHoverBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="LogoBackgroundBrush" Color="#475569"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ExplorerButtonStyle}" />

        <Style x:Key="PrimaryExplorerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ExplorerButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerExplorerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ExplorerButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerButtonBorder"
                                Background="{DynamicResource CancelButtonBackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource CancelButtonHoverBrush}"/>
                                <Setter TargetName="DangerButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DangerButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <Border Width="26" Height="26"
                                CornerRadius="8"
                                VerticalAlignment="Center"
                                Background="{DynamicResource LogoBackgroundBrush}">
                            <Image Source="../Assets/app.ico"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock x:Name="TitleText"
                                   Text="LEGACY EXPLORE"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>

                        <TextBlock Text="• Explorer"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="—"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeButton_Click"/>
                        <Button Content="×"
                                Style="{StaticResource WindowButtonStyle}"
                                FontSize="18"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource PanelStrongBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ARCHIVE"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="ArchiveText"
                                   Text="Loading..."
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SelectAllButton"
                                Content="SELECT ALL"
                                Width="112"
                                Style="{StaticResource ExplorerButtonStyle}"
                                Click="SelectAllButton_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="ClearSelectionButton"
                                Content="CLEAR"
                                Width="92"
                                Style="{StaticResource ExplorerButtonStyle}"
                                Click="ClearSelectionButton_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="DownloadSelectedButton"
                                Content="DOWNLOAD SELECTED"
                                Width="190"
                                Style="{StaticResource PrimaryExplorerButtonStyle}"
                                Click="DownloadSelectedButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="340" MinWidth="240" MaxWidth="650"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        Padding="10">
                    <TreeView x:Name="ExplorerTreeView"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectedItemChanged="ExplorerTreeView_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:LegacyExplorerNode}"
                                                      ItemsSource="{Binding Children}">
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="125"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="NodeCheckBox_Checked"
                                              Unchecked="NodeCheckBox_Unchecked"
                                              VerticalAlignment="Center"/>

                                    <Image Grid.Column="1"
                                           Width="18"
                                           Height="18"
                                           Source="{Binding Icon}"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="7,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding SizeText}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="8,0,8,0"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="FILE INFORMATION"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <Border Margin="0,12,0,0"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="InfoNameText"
                                               Text="Nothing selected"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="InfoPathText"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10"
                                               Margin="0,7,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="TYPE"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,18,0,4"/>
                            <TextBlock x:Name="InfoTypeText"
                                       Text="--"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"/>

                            <TextBlock Text="SIZE"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,15,0,4"/>
                            <TextBlock x:Name="InfoSizeText"
                                       Text="--"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"/>

                            <TextBlock Text="COMPRESSED SIZE"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,15,0,4"/>
                            <TextBlock x:Name="InfoCompressedSizeText"
                                       Text="--"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"/>

                            <TextBlock Text="ARCHIVE METHOD"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,15,0,4"/>
                            <TextBlock x:Name="InfoCompressionText"
                                       Text="--"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"/>

                            <TextBlock Text="MD5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,15,0,4"/>
                            <TextBlock x:Name="InfoMd5Text"
                                       Text="--"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>

                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="10"
                                    Margin="0,22,0,0">
                                <TextBlock x:Name="SelectionSummaryText"
                                           Text="0 files selected"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="LoadingOverlay"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Panel.ZIndex="30"
                        Background="{DynamicResource ModalBackgroundBrush}"
                        Visibility="Collapsed">
                    <Grid>
                        <Border Width="360"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="24">
                            <StackPanel>
                                <TextBlock x:Name="LoadingTitleText"
                                           Text="LOADING ARCHIVE"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="LoadingStatusText"
                                           Text="Reading remote archive..."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>

                                <ProgressBar x:Name="LoadingProgressBar"
                                             IsIndeterminate="True"
                                             Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Background="{DynamicResource PanelStrongBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="86"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="StatusText"
                                   Grid.Column="0"
                                   Text="Ready."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="ProgressText"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                    </Grid>

                    <Border x:Name="DownloadProgressArea"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="CurrentFileText"
                                           Text="Preparing download..."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="LegacyDownloadProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Margin="0,7,0,0"/>
                                <Grid Margin="0,7,0,0">
                                    <TextBlock Text="DOWNLOADED"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="8"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TotalBytesText"
                                               Text="0 B"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="8"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="DownloadedBytesText"
                                       Grid.Column="1"
                                       Text="0 B"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="10,0,16,0"/>

                            <Button x:Name="DownloadPauseButton"
                                    Grid.Column="2"
                                    Content="PAUSE"
                                    Style="{StaticResource ExplorerSecondaryButtonStyle}"
                                    Width="96"
                                    HorizontalAlignment="Center"
                                    Click="DownloadPauseButton_Click"
                                    Visibility="Collapsed"/>

                            <Button x:Name="DownloadCancelButton"
                                    Grid.Column="3"
                                    Content="CANCEL"
                                    Style="{StaticResource DangerExplorerButtonStyle}"
                                    Width="96"
                                    HorizontalAlignment="Center"
                                    Click="DownloadCancelButton_Click"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
