<UserControl x:Class="SophonDownloader.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ABOUT" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="Sophon Downloader" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Background="{DynamicResource PanelStrongBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Sophon Downloader"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock Text="An advanced tool for downloading game assets using the Sophon-based content delivery system. This application only downloads assets, it is not the game launcher."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,6,0,14"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Version" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="DetailVersionText"
                               Grid.Column="1"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Copyright" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="CopyrightText"
                               Grid.Column="1"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="License" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="GNU General Public License v3.0"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Project status" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="Independent"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Project" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="1"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap">
                        <Hyperlink NavigateUri="https://github.com/GesthosNetwork/Sophon-Downloader"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            Sophon-Downloader
                        </Hyperlink>
                    </TextBlock>
                </Grid>

                <Border Margin="0,18,0,0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="SophonDownloader is not affiliated with, endorsed by, sponsored by, or otherwise associated with HoYoverse, miHoYo, Cognosphere, or the operators of the supported games. Third-party game names, trademarks, logos, characters, artwork, assets, and other proprietary materials remain the property of their respective rights holders."/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
